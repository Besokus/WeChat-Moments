# FriendService pseudocode

TYPE Result {
  success: bool
  message: string
}

TYPE PageResult<T> {
  items: list<T>
  next_cursor: string?
  has_more: bool
}

SERVICE FriendService {
  DEPENDS ON UserRepository
  DEPENDS ON FriendRepository

  # 职责：建立双向好友关系（两条单向边）。
  function addFriend(userId: long, friendId: long) -> Result:
    if userId <= 0 or friendId <= 0 or userId == friendId:
      return Result(false, "invalid request")

    if userRepository.getById(userId) is null or userRepository.getById(friendId) is null:
      return Result(false, "user not found")

    if friendRepository.Exists(userId, friendId):
      return Result(true, "already friend")

    friendRepository.Insert(userId, friendId, ACTIVE, now())
    friendRepository.Insert(friendId, userId, ACTIVE, now())
    return Result(true, "ok")

  # 职责：按 cursor + limit 分页查询某用户好友列表。
  function listFriends(userId: long, cursor: string?, limit: int) -> PageResult<Friendship>:
    if userId <= 0:
      return PageResult([], null, false)

    size = clamp(limit, 1, 100)
    rows = friendRepository.ListByUser(userId, cursor, size + 1)

    hasMore = length(rows) > size
    pageRows = takeFirst(rows, size)
    nextCursor = null
    if hasMore and length(pageRows) > 0:
      last = pageRows[length(pageRows) - 1]
      nextCursor = encodeCursor(last.created_at, last.friend_id)

    return PageResult(pageRows, nextCursor, hasMore)
}
