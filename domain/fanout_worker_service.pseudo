# FanoutWorkerService pseudocode (async fan-out)

SERVICE FanoutWorkerService {
  DEPENDS ON OutboxRepository
  DEPENDS ON FriendRepository
  DEPENDS ON FriendListCacheRepository   # optional read optimization
  DEPENDS ON FeedInboxRepository

  CONST MAX_RETRY = 16
  CONST CHUNK_SIZE = 200
  CONST MERGE_WINDOW_SECONDS = 5
  CONST PARTITION_PENDING_SOFT_LIMIT = 20000
  CONST PARTITION_PENDING_HARD_LIMIT = 100000
  CONST MAX_EVENTS_PER_PARTITION_CYCLE = 1000

  # 职责：按分区消费 Outbox，并在积压场景执行背压与降速。
  function processPendingEvents(nowTs: timestamp) -> void:
    partitions = outboxRepository.ListActivePartitions(nowTs)
    for partitionKey in partitions:
      pending = outboxRepository.CountPendingByPartition(partitionKey, nowTs)

      if pending >= PARTITION_PENDING_HARD_LIMIT:
        emitAlert("outbox hard backlog", partitionKey, pending)
        continue

      quota = MAX_EVENTS_PER_PARTITION_CYCLE
      if pending >= PARTITION_PENDING_SOFT_LIMIT:
        quota = MAX_EVENTS_PER_PARTITION_CYCLE / 4

      events = outboxRepository.FetchPendingByPartition(partitionKey, quota, nowTs)
      groups = mergeByAuthorWithinWindow(events, MERGE_WINDOW_SECONDS)

      for group in groups:
        processAuthorGroup(group, nowTs)

  # 职责：按 author 短窗口合并处理，减少重复读取 5000 好友。
  function processAuthorGroup(group: list<OutboxEvent>, nowTs: timestamp) -> void:
    executable = []
    for event in group:
      if outboxRepository.MarkProcessing(event.event_id):
        executable.append(event)

    if length(executable) == 0:
      return

    authorId = executable[0].payload["author_id"]
    # V1 正式路径：所有作者统一走 push fan-out。
    # 未来可演进为普通用户 push / 大V pull 的 hybrid，但不属于当前执行链路。
    route = RouteContext(authorId, null)

    try:
      friends = loadFriendsForFanout(authorId, route)
      friendGroups = groupByRouteKey(friends, key = friend_id)

      for friendGroup in friendGroups:
        groupRoute = RouteContext(friendGroup.route_key, null)
        items = []

        for friendRow in friendGroup.rows:
          for event in executable:
            items.append(
              FeedInbox(friendRow.friend_id, event.payload["created_at"], event.aggregate_id, authorId)
            )

            # 按最终 FeedInbox item 数切分，避免 friend chunk * event count 放大。
            if length(items) >= CHUNK_SIZE:
              feedInboxRepository.BatchUpsertByRoute(groupRoute, items, CHUNK_SIZE)
              items = []

        if length(items) > 0:
          feedInboxRepository.BatchUpsertByRoute(groupRoute, items, CHUNK_SIZE)

      for event in executable:
        outboxRepository.MarkSucceeded(event.event_id)
    catch err:
      for event in executable:
        retryCount = event.retry_count + 1
        if retryCount >= MAX_RETRY:
          outboxRepository.MoveToDeadLetter(event.event_id, "fanout max retry exceeded")
        else:
          nextRetryAt = computeExponentialBackoff(nowTs, retryCount)
          outboxRepository.MarkFailed(event.event_id, retryCount, nextRetryAt)

  # 职责：可选使用好友列表缓存降低重复读取；Friendship 仍是真相源。
  function loadFriendsForFanout(authorId: long, route: RouteContext) -> list<Friendship>:
    if friendListCacheRepository is null:
      return friendRepository.ListByUser(authorId, null, 5000, route)

    cached = friendListCacheRepository.GetByUser(authorId)
    if cached is not null:
      return cached

    friends = friendRepository.ListByUser(authorId, null, 5000, route)
    # cache miss / 过期后回源 Friendship；缓存仅用于读优化，不参与真相判定。
    friendListCacheRepository.SetByUser(authorId, friends, 30)
    return friends
}

