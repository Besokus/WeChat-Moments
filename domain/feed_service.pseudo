# FeedService compatibility pseudocode

SERVICE FeedService {
  DEPENDS ON TimelineService

  # 职责：兼容旧命名，实际委托给 TimelineService.listFriendMoments。
  function listFriendTimeline(viewerId: long, cursor: string?, limit: int) -> PageResult<Post>:
    return timelineService.listFriendMoments(viewerId, cursor, limit)
}
