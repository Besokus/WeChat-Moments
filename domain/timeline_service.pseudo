# TimelineService pseudocode

TYPE PageResult<T> {
  items: list<T>
  next_cursor: string?
  has_more: bool
}

SERVICE TimelineService {
  DEPENDS ON FeedInboxRepository
  DEPENDS ON MomentRepository

  # 职责：从预计算 FeedInbox 分页读取好友动态时间线，并批量回查动态详情。
  function listFriendMoments(viewerId: long, cursor: string?, limit: int) -> PageResult<Post>:
    if viewerId <= 0:
      return PageResult([], null, false)

    size = clamp(limit, 1, 100)

    inboxRows = feedInboxRepository.ListByUser(viewerId, cursor, size + 1)  # created_at DESC

    hasMore = length(inboxRows) > size
    pageInboxRows = takeFirst(inboxRows, size)

    postIds = []
    for row in pageInboxRows:
      postIds.append(row.post_id)

    postMap = toMap(momentRepository.BatchGet(postIds), key = post_id)

    items = []
    for row in pageInboxRows:
      post = postMap[row.post_id]
      if post is not null:
        items.append(post)

    nextCursor = null
    if hasMore and length(pageInboxRows) > 0:
      last = pageInboxRows[length(pageInboxRows) - 1]
      nextCursor = encodeCursor(last.created_at, last.post_id)

    return PageResult(items, nextCursor, hasMore)
}
