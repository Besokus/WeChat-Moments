# Moment API (pseudo)

TYPE PageResult<T> {
  items: list<T>
  next_cursor: string?
  has_more: bool
}

TYPE PublishResult {
  post_id: long
  accepted: bool
  message: string
}

INTERFACE MomentAPI {
  PublishMoment(user_id: long, content_text: string, request_id: string) -> PublishResult
  ListUserMoments(author_id: long, cursor: string?, limit: int) -> PageResult<Post>
}
