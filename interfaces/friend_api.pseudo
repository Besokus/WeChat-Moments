# Friend API (pseudo)

TYPE PageResult<T> {
  items: list<T>
  next_cursor: string?
  has_more: bool
}

TYPE Result {
  success: bool
  message: string
}

INTERFACE FriendAPI {
  AddFriend(user_id: long, friend_id: long) -> Result
  ListFriends(user_id: long, cursor: string?, limit: int) -> PageResult<Friendship>
}
