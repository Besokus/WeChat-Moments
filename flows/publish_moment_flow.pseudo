# Publish moment flow skeleton (reliability-focused)

FLOW PublishMomentFlow(author_id: long, content_text: string, request_id: string) {
  STEP 1: validate input and request_id
  STEP 2: build Post + OutboxEvent payload
  STEP 3: atomically write Post + Outbox + Idempotency record
  STEP 4: return accepted with post_id
  STEP 5: async worker consumes outbox and fan-out writes FeedInbox in chunks
}
