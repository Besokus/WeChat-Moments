# Repository layer pseudocode (reliability-focused)

TYPE PageRequest {
  cursor: string?
  limit: int
}

TYPE RouteContext {
  route_key: long           # shard/partition routing key
  route_bucket: string?     # optional logical bucket
}

TYPE OutboxEvent {
  event_id: long
  aggregate_type: string    # POST
  aggregate_id: long        # post_id
  payload: map<string, any>
  status: string            # PENDING/PROCESSING/SUCCEEDED/FAILED
  retry_count: int
  next_retry_at: timestamp?
  created_at: timestamp
}

TYPE IdempotencyRecord {
  op_name: string
  request_id: string
  result_ref: string?
  created_at: timestamp
}

INTERFACE FriendRepository {
  Exists(user_id: long, friend_id: long, route: RouteContext) -> bool
  UpsertEdge(user_id: long, friend_id: long, status: tinyint, created_at: timestamp, route: RouteContext) -> void

  # cursor + limit pagination by user
  ListByUser(user_id: long, cursor: string?, limit: int, route: RouteContext) -> list<Friendship>
}

INTERFACE MomentRepository {
  Get(post_id: long, route: RouteContext) -> Post?

  # 批量按 post_id 获取，仓储内部按 post_id 路由到对应分片。
  BatchGetByPostIds(post_ids: list<long>) -> list<Post>

  # cursor + limit pagination by one author
  ListByAuthor(author_id: long, cursor: string?, limit: int, route: RouteContext) -> list<Post>

  # atomic boundary for reliability: Post + Outbox + Idempotency
  InsertPostWithOutboxAndIdempotency(
    post: Post,
    event: OutboxEvent,
    op_name: string,
    request_id: string,
    route: RouteContext
  ) -> bool
}

INTERFACE FeedInboxRepository {
  # idempotent upsert by unique (user_id, post_id), with chunk control
  BatchUpsertByRoute(
    route: RouteContext,
    items: list<FeedInbox>,
    chunk_size: int
  ) -> void

  # cursor + limit pagination by viewer inbox, ordered by created_at desc
  ListByUser(user_id: long, cursor: string?, limit: int, route: RouteContext) -> list<FeedInbox>

  # data lifecycle for long-term storage/index control
  DeleteBefore(user_id: long, expire_before: timestamp, route: RouteContext) -> int
}

INTERFACE OutboxRepository {
  FetchPending(batch_size: int, now_ts: timestamp) -> list<OutboxEvent>
  MarkProcessing(event_id: long) -> bool
  MarkSucceeded(event_id: long) -> void
  MarkFailed(event_id: long, retry_count: int, next_retry_at: timestamp?) -> void
}

INTERFACE IdempotencyRepository {
  Get(op_name: string, request_id: string) -> IdempotencyRecord?
  Save(op_name: string, request_id: string, result_ref: string) -> void
}

# 正式时间线读取路径只使用 FeedInboxRepository.ListByUser。
# 不提供读时按 friendIds 聚合最近动态的仓储方法，避免误用为主路径。
