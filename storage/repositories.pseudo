# Repository layer pseudocode (reliability-focused)

TYPE PageRequest {
  cursor: string?
  limit: int
}

TYPE RouteContext {
  route_key: long           # shard/partition routing key
  route_bucket: string?     # optional logical bucket
}

TYPE OutboxEvent {
  event_id: long
  aggregate_type: string    # POST
  aggregate_id: long        # post_id
  payload: map<string, any>
  status: string            # PENDING/PROCESSING/SUCCEEDED/FAILED
  retry_count: int
  next_retry_at: timestamp?
  created_at: timestamp
}

TYPE IdempotencyRecord {
  op_name: string
  actor_id: long            # idempotency scope key to avoid cross-user request_id collision
  request_id: string
  result_ref: string?       # publishMoment stores post_id here
  created_at: timestamp
}

INTERFACE FriendRepository {
  Exists(user_id: long, friend_id: long, route: RouteContext) -> bool
  UpsertEdge(user_id: long, friend_id: long, status: tinyint, created_at: timestamp, route: RouteContext) -> void

  # cursor + limit pagination by user
  ListByUser(user_id: long, cursor: string?, limit: int, route: RouteContext) -> list<Friendship>

  # persisted repair task for one-way edge anomalies; worker must upsert both edges idempotently.
  EnqueueEdgePairRepair(user_id: long, friend_id: long, created_at: timestamp) -> void
}

INTERFACE MomentRepository {
  Get(post_id: long, route: RouteContext) -> Post?

  # MUST dedupe post_ids and group by post_id shard key inside repository.
  # post_id must be globally unique and routable through id bits or metadata mapping.
  BatchGetByPostIds(post_ids: list<long>) -> list<Post>

  # cursor + limit pagination by one author
  ListByAuthor(author_id: long, cursor: string?, limit: int, route: RouteContext) -> list<Post>

  # atomic boundary for reliability: Post + Outbox + Idempotency.
  # precondition: these writes must land in the same route/partition transaction boundary.
  # publishMoment idempotency result_ref must be post.post_id.
  InsertPostWithOutboxAndIdempotency(
    post: Post,
    event: OutboxEvent,
    op_name: string,
    actor_id: long,
    request_id: string,
    route: RouteContext
  ) -> bool
}

INTERFACE FeedInboxRepository {
  # idempotent upsert by unique (user_id, post_id), with chunk control
  BatchUpsertByRoute(
    route: RouteContext,
    items: list<FeedInbox>,
    chunk_size: int
  ) -> void

  # cursor + limit pagination by viewer inbox, ordered by created_at desc
  ListByUser(user_id: long, cursor: string?, limit: int, route: RouteContext) -> list<FeedInbox>

  # V1 only guarantees recent timeline within retention; older history is outside this project scope.
  DeleteBefore(user_id: long, expire_before: timestamp, route: RouteContext) -> int
  DeleteOldestExceed(user_id: long, keep_rows: int, route: RouteContext) -> int
}

INTERFACE TimelineCacheRepository {
  # optional read optimization for first page; not source of truth
  GetFirstPage(viewer_id: long, limit: int) -> PageResult<Post>?
  SetFirstPage(viewer_id: long, limit: int, page: PageResult<Post>, ttl_seconds: int) -> void
}


INTERFACE FriendListCacheRepository {
  # optional fan-out read optimization only; Friendship remains source of truth
  GetByUser(user_id: long) -> list<Friendship>?
  SetByUser(user_id: long, friends: list<Friendship>, ttl_seconds: int) -> void
}
INTERFACE OutboxRepository {
  # queue partition control for write-fanout throughput governance
  ListActivePartitions(now_ts: timestamp) -> list<long>
  CountPendingByPartition(partition_key: long, now_ts: timestamp) -> int
  FetchPendingByPartition(partition_key: long, batch_size: int, now_ts: timestamp) -> list<OutboxEvent>

  MarkProcessing(event_id: long) -> bool
  MarkSucceeded(event_id: long) -> void
  MarkFailed(event_id: long, retry_count: int, next_retry_at: timestamp?) -> void
  MoveToDeadLetter(event_id: long, reason: string) -> void
}

INTERFACE IdempotencyRepository {
  Get(op_name: string, actor_id: long, request_id: string) -> IdempotencyRecord?
  Save(op_name: string, actor_id: long, request_id: string, result_ref: string) -> void
}

# 正式时间线读取路径只使用 FeedInboxRepository.ListByUser。
# 不提供读时按 friendIds 聚合最近动态的仓储方法，避免误用为主路径。

