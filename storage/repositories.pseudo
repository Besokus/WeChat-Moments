# Repository layer pseudocode (minimal)

TYPE PageRequest {
  cursor: string?
  limit: int
}

INTERFACE FriendRepository {
  Exists(user_id: long, friend_id: long) -> bool
  Insert(user_id: long, friend_id: long, status: tinyint, created_at: timestamp) -> void

  # cursor + limit pagination by user
  ListByUser(user_id: long, cursor: string?, limit: int) -> list<Friendship>
}

INTERFACE MomentRepository {
  Insert(moment: Post) -> void
  Get(post_id: long) -> Post?
  BatchGet(post_ids: list<long>) -> list<Post>

  # cursor + limit pagination by one author
  ListByAuthor(author_id: long, cursor: string?, limit: int) -> list<Post>

  # batch query recent posts by multiple authors
  ListRecentByAuthors(author_ids: list<long>, cursor: string?, limit: int) -> list<Post>
}
