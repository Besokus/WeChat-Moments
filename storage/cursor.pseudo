# Cursor contract (pseudo)

TYPE PageRequest {
  cursor: string?
  limit: int
}

TYPE PageResult<T> {
  items: list<T>
  next_cursor: string?
  has_more: bool
}

MODULE CursorCodec {
  # Post and FeedInbox cursor: (created_at, post_id).
  EncodePostCursor(created_at: timestamp, post_id: long) -> string

  # Friendship cursor: (created_at, friend_id).
  EncodeFriendCursor(created_at: timestamp, friend_id: long) -> string

  # Decode and validate cursor format/version.
  Decode(cursor: string?) -> map<string, any>

  ValidateLimit(limit: int, default_limit: int, max_limit: int) -> int

  # Post/FeedInbox next page predicate:
  # WHERE created_at < last.created_at
  # OR (created_at = last.created_at AND post_id < last.post_id).

  # Friendship next page predicate:
  # WHERE created_at < last.created_at
  # OR (created_at = last.created_at AND friend_id < last.friend_id).
}
